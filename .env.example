# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@host/db

# Random secret for signing cookies: run `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=you@example.com
